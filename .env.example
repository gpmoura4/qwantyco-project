# Copy to .env and fill in locally. Never commit .env.

# --- Local LLM (Ollama) ---
# Ollama server URL (default local install).
OLLAMA_BASE_URL=
# Model tag pulled in Ollama (chosen at the end of step 3; see docs/decisoes.md).
OLLAMA_MODEL=

# --- LangSmith (tracing and evaluation) ---
# "true" to send traces to LangSmith.
LANGSMITH_TRACING=
# Personal LangSmith API key (free plan).
LANGSMITH_API_KEY=
# LangSmith project name where traces are grouped.
LANGSMITH_PROJECT=

# --- Failure simulation (optional; off when empty) ---
# Format tool:mode:times, comma-separated. Modes: error | timeout | invalid_output.
# Example: listar_chamados:error:2 (each call fails twice, then works).
SIMULATE_TOOL_FAILURE=
